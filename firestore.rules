rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite lectura pública de contenidos de la landing y escritura autenticada
    match /landing_sections/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_destinations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_profiles/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_reviews/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Formulario de leads y postulaciones: creación pública, lectura y administración protegidas
    match /landing_leads/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /landing_applications/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
