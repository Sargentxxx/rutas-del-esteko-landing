rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite lectura pública de secciones, destinos, galerías y configuraciones
    match /landing_sections/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_destinations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /landing_profiles/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Permite escritura pública de leads y postulaciones de empleo
    match /landing_leads/{docId} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    match /landing_applications/{docId} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    // Regla de prueba
    match /test_migration/{docId} {
      allow read, write: if true;
    }
  }
}
